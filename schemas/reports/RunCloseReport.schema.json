            "array"
          ]
        },
        "quality_path": {
          "type": "object"
        },
        "redline_history": {
          "type": "object"
        },
        "installed_inventory": {
          "type": [
            "object",
            "array"
          ]
        },
        "machine_evidence_summary": {
          "type": [
            "object",
            "array"
          ]
        },
        "run_close_observations": {
          "type": [
            "object",
            "array"
          ]
        },
        "final_close_result": {
          "type": "object"
        },
        "source_traceability": {
          "type": "object"
        },
        "access_policy_snapshot": {
          "type": "object"
        }
